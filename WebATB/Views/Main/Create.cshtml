@{
    Layout = "MainLoyaut"; // Не використовуємо Layout
}

<h1 class="text-center">Додати користувача</h1>
@model WebATB.Models.Users.UserItemModel
@{
    Layout = "MainLoyaut"; // Використовуємо твій Layout
}

<div class="container mt-5">
    <h1 class="text-center">Додати користувача</h1>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <form asp-action="Create" method="post" enctype="multipart/form-data">

                <div class="mb-3">
                    <label class="form-label">ПІБ</label>
                    <input asp-for="Name" class="form-control" placeholder="Введіть ім'я">
                </div>

                <div class="mb-3">
                    <label class="form-label">Телефон</label>
                    <input asp-for="Phone" class="form-control" placeholder="+380...">
                </div>

                <div class="mb-3">
                    <label class="form-label">Фото користувача</label>
                    <input type="file" name="imageFile" class="form-control" accept="image/*">
                </div>

                <div class="text-center">
                    <button type="submit" class="btn btn-primary">Зберегти</button>
                    <a asp-action="Index" class="btn btn-secondary">Назад</a>
                </div>

            </form>
        </div>
    </div>
</div>
